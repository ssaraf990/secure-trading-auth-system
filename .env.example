# Copy this file to .env and fill in your values
# Never commit .env to version control!

# Flask secret key — change this to a long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# Gmail SMTP settings for OTP emails
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to Google Account > Security > App Passwords
# 3. Generate an App Password for "Mail"
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# Optional: Finnhub API key for live stock prices (free tier available)
# Get one at https://finnhub.io
FINNHUB_API_KEY=your-finnhub-api-key

# Optional: PIN for biometric fallback during development
DEV_PIN=123456

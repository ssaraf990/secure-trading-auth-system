{
  "components": {
    "biometricVerification": {
      "Spoofing": "Fake WebAuthn credentials or cloned keys",
      "Mitigation": "Server-side signature validation via @simplewebauthn/server and challenge-response verification"
    },
    "stockAPI": {
      "InformationDisclosure": "API key exposure in frontend",
      "Mitigation": "Proxy all API calls through backend and hide keys in environment variables"
    },
    "dummyTrading": {
      "Tampering": "Manipulated trade requests without verification",
      "Mitigation": "Require verified biometric token before confirming trades, validate on server-side"
    },
    "userAuthentication": {
      "Spoofing": "Brute force password attacks",
      "Mitigation": "Account locking after failed attempts, OTP-based 2FA, password hashing"
    },
    "sessionManagement": {
      "Repudiation": "Unauthorized actions cannot be traced",
      "Mitigation": "Session tracking, transaction logging with user_id and timestamps"
    },
    "database": {
      "Tampering": "SQL injection attacks",
      "Mitigation": "Parameterized queries, input validation, prepared statements"
    },
    "emailOTP": {
      "InformationDisclosure": "OTP interception via email",
      "Mitigation": "Time-limited OTPs (5 minutes), one-time use, secure email delivery"
    },
    "walletBalance": {
      "Tampering": "Client-side balance manipulation",
      "Mitigation": "Server-side balance validation, database transactions, atomic operations"
    }
  },
